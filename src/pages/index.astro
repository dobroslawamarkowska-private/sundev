---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="sundev.pl" description="Personal blog and articles by a developer at sundev.pl">
  <section style="margin-bottom: var(--space-16)">
    <h2 class="section-heading">Recent Posts</h2>
    {posts.length === 0
      ? <p style="color: var(--color-muted)">No posts yet.</p>
      : (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-item">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
    <p style="margin-top: var(--space-8)"><a href="/blog">All posts →</a></p>
  </section>

  {articles.length > 0 && (
    <section>
      <h2 class="section-heading">Articles</h2>
      <ul class="post-list">
        {articles.map((article) => (
          <li class="post-item">
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2><a href={`/articles/${article.slug}`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
          </li>
        ))}
      </ul>
      <p style="margin-top: var(--space-8)"><a href="/articles">All articles →</a></p>
    </section>
  )}
</BaseLayout>
