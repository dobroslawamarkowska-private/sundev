---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Articles" description="Long-form articles on sundev.pl">
  <h1 class="section-heading">Articles</h1>
  {articles.length === 0
    ? <p style="color: var(--color-muted)">No articles yet — check back soon.</p>
    : (
      <ul class="post-list">
        {articles.map((article) => (
          <li class="post-item">
            <time datetime={article.data.date.toISOString()}>
              {article.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2><a href={`/articles/${article.slug}`}>{article.data.title}</a></h2>
            <p>{article.data.description}</p>
            {article.data.tags.length > 0 && (
              <div class="tags">
                {article.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
